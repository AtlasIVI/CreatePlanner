          "id": "create:white_sail",
          "count": "sails"
        }
      ],
      "params": [
        {
          "name": "sails",
          "label": {
            "fr": "Voiles",
            "en": "Sails"
          },
          "default": 64,
          "min": 8,
          "max": 512,
          "step": 1
        }
      ],
      "rpm": "clamp(floor(sails/8),1,16)",
      "capacity": "512*rpm",
      "source": "https://github.com/Creators-of-Create/Create/blob/mc1.21.1/dev/src/main/java/com/simibubi/create/content/contraptions/bearing/WindmillBearingBlockEntity.java + https://github.com/Creators-of-Create/Create/blob/mc1.21.1/dev/src/main/java/com/simibubi/create/AllBlocks.java (capacity 512) + CKinetics windmillSailsPerRPM=8, minimumWindmillSails=8",
      "verified": true,
