      "rpm": "8",
      "capacity": "32*rpm",
      "source": "https://github.com/Creators-of-Create/Create/blob/mc1.21.1/dev/src/main/java/com/simibubi/create/AllBlocks.java (capacity 32, generator speed 8) + content/kinetics/waterwheel/WaterWheelBlockEntity.java (8/size)",
