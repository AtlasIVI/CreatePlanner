    {
      "id": "create:crushing_wheels",
      "names": {
        "fr": "Roues de broyage (paire)",
        "en": "Crushing Wheels (pair)"
      },
      "recipeTypes": [
        "create:crushing",
        "create:milling"
      ],
      "kinetic": true,
      "blocks": [
        {
          "id": "create:crushing_wheel",
          "count": 1
        }
      ],
      "unitsPerMachine": "2",
      "stressImpact": {
        "value": 8,
        "source": "https://github.com/Creators-of-Create/Create/blob/mc1.21.1/dev/src/main/java/com/simibubi/create/AllBlocks.java",
        "verified": true,
        "note": "Per wheel; a pair = 2 wheels"
      },
      "speed": {
        "let": {
          "v": "rpm/50*4",
          "p1": "clamp(v/log2(batch),0.25,20)",
          "n1": "if(duration>=20,floor((duration-20)/p1)+1,1)",
          "r1": "duration-n1*p1"
        },
        "ticksPerOperation": "n1+max(1,ceil(r1/clamp(v,0.25,20)))",
        "executionsPerOperation": "batch",
        "defaultDuration": 100,
        "defaultBatch": 1,
        "source": "https://github.com/Creators-of-Create/Create/blob/mc1.21.1/dev/src/main/java/com/simibubi/create/content/kinetics/crusher/CrushingWheelControllerBlockEntity.java",
        "verified": true,
        "note": "crushingspeed=|rpm|/50 (CrushingWheelControllerBlock). The whole inserted stack is processed at once; with a single item log2(1)=0 so speed clamps to 20 regardless of RPM. Item insertion time not included."
      },
      "gridBlock": "create:crushing_wheel",
      "shape": "shaft"
    },
